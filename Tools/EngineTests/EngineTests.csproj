<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <UseAppHost>false</UseAppHost>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="NUnitShim.cs" />
    <Compile Include="../../Assets/Tests/Editor/XOEngineTests.cs" />
    <Compile Include="TowerExpansionTests.cs" />
    <Compile Include="RegressionTests.cs" Condition="Exists('RegressionTests.cs')" />
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
