<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Point this at your Unity install: dotnet run -p:UnityManagedDir="/path/to/Editor/Data/Managed" -->
    <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">C:\Program Files\Unity\Hub\Editor\6000.3.28f1\Editor\Data\Managed</UnityManagedDir>
  </PropertyGroup>

  <Target Name="CheckUnityManagedDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(UnityManagedDir)')">
    <Error Text="UnityManagedDir '$(UnityManagedDir)' not found. Pass -p:UnityManagedDir=&lt;Unity&gt;/Editor/Data/Managed. For rule-engine tests that need no Unity install, run Tools/EngineTests instead." />
  </Target>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Scripts\Core\*.cs" />
    <Compile Include="..\..\Assets\Scripts\Ads\XOPlayableAdsBridge.cs" />
    <Compile Include="..\..\Assets\Scripts\Visuals\XOProceduralAssets.cs" />
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedDir)\UnityEngine\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDir)\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityManagedDir)\UnityEngine\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityManagedDir)\UnityEngine\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityManagedDir)\UnityEngine\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\Library\ScriptAssemblies\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
